{
	"name": "field-quality",
	"version": "2.2.0",
	"description": "Fluent JSON Validation Library",
	"repository": {
		"type": "git",
		"url": "ssh://git@code.ai.org:7999/~jplahitko/fieldquality.git"
	},
	"license": "MIT",
	"types": "dist/index.d.ts",
	"main": "dist/index.js",
	"dependencies": {
		"pipeline-utility": "^1.0.2",
		"ramda": "^0.30.1"
	},
	"devDependencies": {
		"@types/jasmine": "^4.6.4",
		"@types/node": "^18.19.65",
		"@types/ramda": "^0.28.25",
		"jasmine": "^3.99.0",
		"jshint": "^2.13.6",
		"ramda": "^0.30.1",
		"rimraf": "^6.0.1",
		"tsx": "^4.7.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.5"
	},
	"scripts": {
		"build": "rimraf dist/* && npm run build:cjs && npm run build:esm && npm run build:types",
		"build:cjs": "tsc -p tsconfig.cjs.json",
		"build:esm": "tsc -p tsconfig.esm.json",
		"build:types": "tsc -p tsconfig.types.json",
		"review": "npm run type-check && npm run test",
		"test": "vitest",
		"test:watch": "tsx watch --test spec/**/*.spec.ts",
		"type-check": "tsc --noEmit",
		"watch": "tsc -p . --watch",
		"benchmark": "vitest bench"
	},
	"publishConfig": {
		"registry": "https://registry.ai.org/repository/npm-hosted/"
	}
}