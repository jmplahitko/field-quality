{
	"name": "field-quality",
	"version": "2.2.0",
	"description": "Fluent JSON Validation Library",
	"repository": {
		"type": "git",
		"url": "ssh://git@code.ai.org:7999/~jplahitko/fieldquality.git"
	},
	"license": "MIT",
	"types": "dist/index.d.ts",
	"main": "dist/index.js",
	"dependencies": {
		"ramda": "^0.30.1",
		"pipeline-utility": "^1.0.0"
	},
	"devDependencies": {
		"@types/jasmine": "^4.6.4",
		"@types/node": "^18.19.65",
		"@types/ramda": "^0.28.25",
		"jasmine": "^3.99.0",
		"jshint": "^2.13.6",
		"ramda": "^0.30.1",
		"rimraf": "^6.0.1",
		"tsx": "^4.7.1",
		"typescript": "^5.7.2"
	},
	"scripts": {
		"bench": "ts-node --script-mode ./benchmark/index.ts",
		"build": "rimraf dist/* && npm run build:types && npm run build:js",
		"build:js": "babel src --out-dir dist --extensions \".ts,.tsx\" --source-maps inline",
		"build:types": "tsc --emitDeclarationOnly",
		"docs:dev": "vuepress dev docs",
		"docs:build": "vuepress build docs",
		"review": "npm run type-check && npm run test",
		"test": "jasmine-ts \"spec/**/*.spec.ts\"",
		"type-check": "tsc --noEmit",
		"watch": "tsc -p . --watch"
	},
	"publishConfig": {
		"registry": "https://registry.ai.org/repository/npm-hosted/"
	}
}